    <!-- =================== -->
    <!--     AFFIRMATIONS    -->
    <!-- =================== -->

    <string name="affirmation_day_01">Ich habe heute die Kraft, Veränderungen zu bewirken.</string>
    <string name="affirmation_day_02">Meine Ziele spiegeln meine Werte wider.</string>
    <string name="affirmation_day_03">Ich bin fähig, zu wachsen – jeden einzelnen Tag.</string>
    <string name="affirmation_day_04">Herausforderungen zeigen mir, woraus ich gemacht bin.</string>
    <string name="affirmation_day_05">Ich vertraue meinem inneren Kompass.</string>
    <string name="affirmation_day_06">Ich darf Fehler machen – und daraus lernen.</string>
    <string name="affirmation_day_07">Meine Stimme zählt. Ich drücke meine Wahrheit aus.</string>
    <string name="affirmation_day_08">Ich wähle heute Freundlichkeit – zu mir und anderen.</string>
    <string name="affirmation_day_09">Ich nehme mir Raum zum Atmen.</string>
    <string name="affirmation_day_10">Ich bin genug – genau wie ich bin.</string>
    <string name="affirmation_day_11">Heute setze ich klare Prioritäten.</string>
    <string name="affirmation_day_12">Ich lasse los, was mir nicht mehr dient.</string>
    <string name="affirmation_day_13">Ich höre auf mein Bauchgefühl.</string>
    <string name="affirmation_day_14">Ich bin kreativ – Lösungen warten auf mich.</string>
    <string name="affirmation_day_15">Ich bin mit mir und meinem Umfeld im Gleichgewicht.</string>
    <string name="affirmation_day_16">Ich wähle Klarheit statt Ablenkung.</string>
    <string name="affirmation_day_17">Ich ehre meine Erfolge – groß wie klein.</string>
    <string name="affirmation_day_18">Ich vertraue dem Prozess.</string>
    <string name="affirmation_day_19">Ich bin stolz auf meinen Weg – egal wie steinig.</string>
    <string name="affirmation_day_20">Ich lerne jeden Tag etwas Neues.</string>
    <string name="affirmation_day_21">Ich bin offen für das Gute, das kommen will.</string>
    <string name="affirmation_day_22">Ich verdiene Liebe – bedingungslos.</string>
    <string name="affirmation_day_23">Ich schenke mir die Pausen, die mein Körper und meine Seele brauchen.</string>
    <string name="affirmation_day_24">Ich verdiene Respekt – auch von mir selbst.</string>
    <string name="affirmation_day_25">Ich gestalte meinen Tag bewusst.</string>
    <string name="affirmation_day_26">Ich vertraue meiner Intuition.</string>
    <string name="affirmation_day_27">Ich nehme Erfolge bewusst wahr</string>
    <string name="affirmation_day_28">Ich stehe ein für mich und für die Vision, die mich antreibt.</string>
    <string name="affirmation_day_29">Ich bin dankbar – für jede Erfahrung.</string>
    <string name="affirmation_day_30">Ich bin mutig – egal, was kommt.</string>
    <string name="affirmation_day_31">Ich bin bereit – für den nächsten Schritt.</string>


